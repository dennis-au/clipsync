# Required: Shared application password. Use a long, unique value generated for
# this deployment. Do not commit the copied .env file.
CLIPSYNC_PASSWORD=replace-with-a-long-random-password

# Docker host port used by compose.example.yaml. Binding to loopback keeps the
# origin private; use a reverse proxy or Cloudflare Tunnel for public access.
CLIPSYNC_HOST_PORT=8787

# Image used by compose.example.yaml. Build the source with
# `docker build -t clipsync:local .`, or set this to a published GHCR tag.
CLIPSYNC_IMAGE=clipsync:local

# The standalone binary refuses to start without CLIPSYNC_PASSWORD. Only a
# deliberately local, non-deployment experiment may opt in to no auth:
# CLIPSYNC_ALLOW_NO_AUTH=1

# Optional retention and capacity limits. These match the application's
# conservative built-in defaults, not any particular deployment.
CLIPSYNC_TTL_DAYS=180
CLIPSYNC_MAX_DISK_MB=1024
CLIPSYNC_MAX_TEXT_MB=64
# Text up to this size stays inline in metadata. Larger text is stored as a
# private blob so room history and items.json remain small.
CLIPSYNC_TEXT_INLINE_KB=64
CLIPSYNC_MAX_IMAGE_MB=64
CLIPSYNC_MAX_FILE_MB=64
CLIPSYNC_UPLOAD_CHUNK_MB=32
# In-progress resumable files reserve only successfully written chunks. These
# caps bound the number of staged sessions and expire inactive sessions quickly.
CLIPSYNC_UPLOAD_TTL_MINUTES=15
CLIPSYNC_UPLOAD_CHUNK_IDLE_SECONDS=120
CLIPSYNC_MAX_UPLOADS=16
CLIPSYNC_MAX_UPLOADS_PER_CLIENT=2
CLIPSYNC_MAX_UPLOADS_PER_ROOM=4

# Room metadata bounds. Room codes use only A-Z, a-z, 0-9, dot, underscore,
# and hyphen; the browser-generated codes fit these defaults.
CLIPSYNC_MAX_ROOMS=128
CLIPSYNC_MAX_ROOM_NAME_BYTES=64
CLIPSYNC_MAX_ITEMS_PER_ROOM=80
CLIPSYNC_MAX_UNPINNED_ITEMS_PER_ROOM=60
CLIPSYNC_MAX_PINNED_ITEMS_PER_ROOM=20

# Connection and abuse controls. Leave this unset unless an explicitly trusted
# reverse proxy is configured. The Cloudflare Tunnel example sets its own fixed
# connector address in its Compose overlay.
# CLIPSYNC_TRUSTED_PROXY_CIDRS=192.0.2.10/32
CLIPSYNC_MAX_SSE=128
CLIPSYNC_MAX_SSE_PER_CLIENT=4

# Required only when starting compose.cloudflare-tunnel.example.yaml. Create a
# remotely managed tunnel in your own Cloudflare account; never commit its token.
# CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-remotely-managed-tunnel-token

# Host-side encrypted backups use exported shell variables and never read .env.
# Keep the private age identity outside this repository.
# CLIPSYNC_BACKUP_DIR=/absolute/path/outside/this/repository
# CLIPSYNC_BACKUP_AGE_RECIPIENT=age1yourpublicrecipient
# CLIPSYNC_BACKUP_RETENTION_DAYS=30
